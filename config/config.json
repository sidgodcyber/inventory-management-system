{
  "app": {
    "name": "Inventory Management System",
    "short_name": "IMS",
    "tagline": "Inventory Management",
    "version": "1.0.0",
    "author": "Siddhi Baluja"
  },
  "paths": {
    "database": "data/inventory.db",
    "log_file": "logs/app.log",
    "export_dir": "exports"
  },
  "logging": {
    "level": "INFO",
    "max_bytes": 1048576,
    "backup_count": 5,
    "format": "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
  },
  "ui": {
    "appearance_mode": "system",
    "color_theme": "blue",
    "window_width": 1320,
    "window_height": 800,
    "min_width": 1200,
    "min_height": 720,
    "screen_margin": 80,
    "sidebar_width": 224,
    "font_family": "Segoe UI",
    "mono_font_family": "Consolas",
    "font_size": 14,
    "heading_size": 24,
    "toast_ms": 3000,
    "search_debounce_ms": 350,
    "table_row_height": 34,
    "chart_dpi": 100,
    "palette": {
      "ground_light": "#F4F3F1",
      "ground_dark": "#111111",
      "surface_light": "#FFFFFF",
      "surface_dark": "#1A1A1A",
      "raised_light": "#EEEEEE",
      "raised_dark": "#2A2A2A",
      "border_light": "#E6E6E6",
      "border_dark": "#2E2E2E",
      "control_light": "#D4D4D4",
      "control_dark": "#444444",
      "grid_light": "#ECECEC",
      "grid_dark": "#2E2E2E",
      "text_light": "#0A0A0A",
      "text_dark": "#F2F2F2",
      "muted_light": "#6B6B6B",
      "muted_dark": "#B4B4B4",
      "primary_light": "#141414",
      "primary_dark": "#F2F2F2",
      "primary_hover_light": "#333333",
      "primary_hover_dark": "#D0D0D0",
      "primary_text_light": "#FFFFFF",
      "primary_text_dark": "#0A0A0A",
      "hue_light": "#1D5FBF",
      "hue_dark": "#6EA8FF",
      "ink_chart_light": "#141414",
      "ink_chart_dark": "#D9D9D9",
      "comparison_light": "#8A8A8A",
      "comparison_dark": "#8A8A8A",
      "danger_light": "#C4242A",
      "danger_dark": "#E5566F",
      "warning_light": "#92400E",
      "warning_dark": "#E0A458",
      "success_light": "#2E7D32",
      "success_dark": "#3FC07A",
      "pill_negative_bg_light": "#FFEDEA",
      "pill_negative_bg_dark": "#2C1A20",
      "pill_negative_ink_light": "#831C1E",
      "pill_negative_ink_dark": "#E5566F",
      "danger_row_light": "#FFF1EE",
      "danger_row_dark": "#2A1B1E",
      "stockout_row_light": "#FFDFD9",
      "stockout_row_dark": "#43222A",
      "inactive_fg_light": "#767676",
      "inactive_fg_dark": "#949494",
      "selection_bg_light": "#E6E6E6",
      "selection_bg_dark": "#333333"
    },
    "strong_font_family": "Segoe UI Semibold",
    "control_height": 34,
    "dashboard_reorder_rows": 8
  },
  "inventory": {
    "currency_symbol": "₹",
    "currency_options": ["₹", "$", "€", "£", "¥"],
    "default_reorder_level": 10,
    "turnover_period_days": 90,
    "chart_days": 30,
    "report_periods": [30, 90, 180],
    "days_of_stock_warning": 7,
    "default_unit": "pcs",
    "units": ["pcs", "box", "kg", "litre", "pack", "dozen", "metre"]
  },
  "display": {
    "page_size": 15,
    "date_format": "%Y-%m-%d",
    "date_format_options": ["%Y-%m-%d", "%d-%m-%Y", "%d/%m/%Y", "%m/%d/%Y", "%d %b %Y"]
  },
  "activity_log": {
    "retention_days": 180
  },
  "auth": {
    "initial_admin_username": "admin",
    "initial_admin_full_name": "Administrator",
    "initial_admin_password": "ChangeMe@123",
    "min_password_length": 8,
    "pbkdf2_iterations": 200000
  },
  "validation": {
    "page_size_min": 5,
    "page_size_max": 100,
    "retention_days_min": 1,
    "retention_days_max": 3650,
    "reorder_level_max": 100000,
    "currency_max_length": 4,
    "text_max_length": 120,
    "notes_max_length": 500,
    "sku_pattern": "^[A-Z0-9][A-Z0-9-]{1,19}$",
    "phone_pattern": "^\\+?[0-9][0-9 \\-]{6,14}$",
    "email_pattern": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$"
  }
}
