{
  "app": {
    "name": "Inventory Management System",
    "short_name": "IMS",
    "tagline": "Inventory Management",
    "version": "1.0.0",
    "author": "Siddhi Baluja",
    "roll_no": "240302054",
    "course": "BBAT104 - Fundamentals of TQM",
    "quality_goal": "Q11 - Improve Maintainability"
  },
  "paths": {
    "database": "data/inventory.db",
    "log_file": "logs/app.log",
    "export_dir": "exports"
  },
  "logging": {
    "level": "INFO",
    "max_bytes": 1048576,
    "backup_count": 5,
    "format": "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"
  },
  "ui": {
    "appearance_mode": "system",
    "color_theme": "blue",
    "window_width": 1320,
    "window_height": 800,
    "min_width": 1200,
    "min_height": 720,
    "screen_margin": 80,
    "sidebar_width": 210,
    "font_family": "Segoe UI",
    "mono_font_family": "Consolas",
    "font_size": 13,
    "heading_size": 20,
    "toast_ms": 3000,
    "search_debounce_ms": 350,
    "table_row_height": 28,
    "chart_dpi": 100,
    "chart_height": 240,
    "palette": {
      "danger": "#D64545",
      "danger_row_light": "#FBE3E3",
      "danger_row_dark": "#5A2626",
      "warning": "#E0A100",
      "success": "#2E9E5B",
      "accent": "#3B7DD8",
      "muted": "#8A8F98",
      "chart_series1_light": "#2A78D6",
      "chart_series1_dark": "#3987E5",
      "chart_series2_light": "#EB6834",
      "chart_series2_dark": "#D95926",
      "stockout_row_light": "#F5B5B5",
      "stockout_row_dark": "#7A2020",
      "inactive_fg_light": "#9AA0A6",
      "inactive_fg_dark": "#7D8187",
      "table_bg_light": "#FFFFFF",
      "table_bg_dark": "#242424",
      "table_fg_light": "#1F2328",
      "table_fg_dark": "#E3E3E3",
      "heading_bg_light": "#E8EBEF",
      "heading_bg_dark": "#333333",
      "selection_bg": "#3B7DD8",
      "selection_fg": "#FFFFFF",
      "card_bg_light": "#DBDBDB",
      "card_bg_dark": "#2B2B2B",
      "chart_bg_light": "#FFFFFF",
      "chart_bg_dark": "#2B2B2B",
      "chart_fg_light": "#1F2328",
      "chart_fg_dark": "#DCE4EE",
      "grid_light": "#E5E7EB",
      "grid_dark": "#3F3F3F",
      "badge_fg": "#FFFFFF"
    }
  },
  "inventory": {
    "currency_symbol": "₹",
    "currency_options": ["₹", "$", "€", "£", "¥"],
    "default_reorder_level": 10,
    "turnover_period_days": 90,
    "chart_days": 30,
    "report_periods": [30, 90, 180],
    "days_of_stock_warning": 7,
    "default_unit": "pcs",
    "units": ["pcs", "box", "kg", "litre", "pack", "dozen", "metre"]
  },
  "display": {
    "page_size": 15,
    "date_format": "%Y-%m-%d",
    "date_format_options": ["%Y-%m-%d", "%d-%m-%Y", "%d/%m/%Y", "%m/%d/%Y", "%d %b %Y"]
  },
  "activity_log": {
    "retention_days": 180
  },
  "operator": {
    "name": "Admin",
    "role": "Admin",
    "roles": ["Admin", "Store Manager", "Store Staff"]
  },
  "validation": {
    "page_size_min": 5,
    "page_size_max": 100,
    "retention_days_min": 1,
    "retention_days_max": 3650,
    "reorder_level_max": 100000,
    "currency_max_length": 4,
    "text_max_length": 120,
    "notes_max_length": 500,
    "sku_pattern": "^[A-Z0-9][A-Z0-9-]{1,19}$",
    "phone_pattern": "^\\+?[0-9][0-9 \\-]{6,14}$",
    "email_pattern": "^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$"
  }
}
